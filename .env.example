# Used by the self-hosted n8n container through docker-compose.yml.
# Never commit the populated .env file.
GITHUB_TOKEN=replace_with_a_fine_grained_or_classic_token
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace_me
N8N_ENCRYPTION_KEY=replace_with_a_long_random_value
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
